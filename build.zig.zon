.{
    .name = .zmenu,
    .version = "1.0.0",
    // When forking a Zig project, this id should be regenerated (delete the
    // field and run `zig build`) if the upstream project is still maintained.
    // Otherwise, the fork is *hostile*, attempting to take control over the
    // original project's identity. Thus it is recommended to leave the comment
    // on the following line intact, so that it shows up in code reviews that
    // modify the field.
    .dependencies = .{
        .zigzag = .{
            .url = "git+https://github.com/meszmate/zigzag?ref=main#0a09aa484719a5257cb87dd0f09b4f7e81adcd5b",
            .hash = "zigzag-0.1.6-YXwYS7UBEwAOOl0w7ju033G2mqu034VzFPp3eMoQJukY",
        },
        .uni = .{
            .url = "git+https://github.com/menosbits/uni#99cecad287b38e26bdddbf883c495b3e4bfe3904",
            .hash = "uni-0.9.0-tz1MSs6cAAA2mr5Iuc1EC-9VRZhN96tpfPWeuZ7nYmq_",
        },
    },
    .fingerprint = 0x2901eafc27c34739, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
